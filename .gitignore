# Build output and local dependencies
**/bin/
**/obj/
**/node_modules/
**/.venv/
**/__pycache__/
/.animation-tools/models/
/.vs/
/.vscode/
*.user
*.suo
*.tmp
*.log

# Credentials, signing secrets and user data
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.dpapi
*.pet-key
*.hudi-key
*.pet-secret
*private*key*
model-settings.json
settings.json
notes.json
notes.json.bak
installation.json

# Retain only build inputs and the ready-to-use Codex pet, not old releases.
/output/*
!/output/hudi-pet-v3/
/output/hudi-pet-v3/*
!/output/hudi-pet-v3/HUDI.ico
!/output/hudi-pet-v6.3/
/output/hudi-pet-v6.3/*
!/output/hudi-pet-v6.3/sprites.zip
!/output/hudi-pet-v6.3/frames/
/output/hudi-pet-v6.3/frames/*
!/output/hudi-pet-v6.3/frames/neutral.png
!/output/hudi-pet-v7/
/output/hudi-pet-v7/*
!/output/hudi-pet-v7/license-public.key
!/output/codex-pet/
/output/codex-pet/*
!/output/codex-pet/pet.json
!/output/codex-pet/spritesheet.png
!/output/codex-pet/adaptation.json
!/output/codex-pet/contact.jpg
