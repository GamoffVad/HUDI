<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="SettingsGlass" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#484C6074" Offset="0"/><GradientStop Color="#282D3D50" Offset="0.28"/><GradientStop Color="#30233243" Offset="0.72"/><GradientStop Color="#40435368" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsEdge" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B8E4F2FC"/><GradientStop Color="#426F8BA5" Offset="0.55"/><GradientStop Color="#7294AEC4" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsField" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#385F758C"/><GradientStop Color="#202E4258" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsButton" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#565D7990"/><GradientStop Color="#323C5269" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsPrimary" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#BAE3F9FF"/><GradientStop Color="#907BCBE3" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="MenuGlass" StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#304A6074"/><GradientStop Color="#10233141" Offset="0.45"/><GradientStop Color="#2843596C" Offset="1"/></LinearGradientBrush>
  <Style x:Key="GlassMenuRow" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="0" Background="Transparent"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#16E8F7FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#22E8F7FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Background" Value="#285DB8DA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{StaticResource SettingsField}"/><Setter Property="BorderBrush" Value="#8495A5"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="35"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SettingsPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
    <Setter Property="Background" Value="{StaticResource SettingsField}"/><Setter Property="BorderBrush" Value="#8495A5"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="10,6,34,6"/><Setter Property="MinHeight" Value="35"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SettingsSelect" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Background" Value="{StaticResource SettingsField}"/><Setter Property="BorderBrush" Value="#8495A5"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="35"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="0"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#DCE8EF" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Margin="10,6,28,6" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="5"><Border Background="#EE202D3A" BorderBrush="#7B91A5" BorderThickness="1" CornerRadius="0" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="230"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource SettingsButton}"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="45"/><Setter Property="Padding" Value="10,10"/>
  </Style>
  <Style x:Key="SettingsSave" TargetType="Button" BasedOn="{StaticResource SettingsAction}"><Setter Property="Background" Value="{StaticResource SettingsPrimary}"/><Setter Property="Foreground" Value="#102632"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SettingsSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,10,0,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="Track" Width="44" Height="26" CornerRadius="0" Background="#394C5F" BorderBrush="#7893A8" BorderThickness="1" Margin="0,0,12,0"><Rectangle x:Name="Knob" Width="19" Height="19" Fill="#F4FCFF" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource SettingsPrimary}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#E6FBFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ComposerSend" TargetType="Button" BasedOn="{StaticResource SettingsSave}">
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="SendSurface" Background="{TemplateBinding Background}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SendSurface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="SendSurface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SendSurface" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SizeRail" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Height" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PetSizeSlider" TargetType="Slider">
    <Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent">
      <Track x:Name="PART_Track" Orientation="Horizontal">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SizeRail}" Background="{StaticResource SettingsPrimary}"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SizeRail}" Background="#4669859C"/></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb x:Name="Knob" Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Rectangle Fill="#EAFBFF" Stroke="#9BE1F6" StrokeThickness="1"/><Rectangle Width="6" Height="6" Fill="#91D5EA"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      </Track>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
