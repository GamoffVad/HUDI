<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HUDI</AssemblyName>
    <RootNamespace>HudiPet</RootNamespace>
    <Version>7.3.7</Version>
    <Description>HUDI — animated desktop companion</Description>
    <ApplicationIcon>../../output/hudi-pet-v3/HUDI.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../output/hudi-pet-v7/native/Hudi.Backdrop.dll" LogicalName="HUDI.Backdrop.dll" />
    <Resource Include="Assets/thinking-dot.png" />
    <EmbeddedResource Include="Assets/water-orb.zip" LogicalName="HUDI.water-orb.zip" />
    <Compile Include="../Shared/Licensing.cs" Link="Licensing.cs" />
    <Compile Include="../Shared/VisualPreview.cs" Link="VisualPreview.cs" />
    <Compile Include="../Shared/FrostedBackdrop.cs" Link="FrostedBackdrop.cs" />
    <EmbeddedResource Include="../../output/hudi-pet-v7/license-public.key" LogicalName="HUDI.license-public.key" />
    <EmbeddedResource Include="../../output/hudi-pet-v7.3/sprites.zip" LogicalName="HudiPet.sprites.zip" />
    <Compile Remove="GazeFrame.cs;DesktopActivityMonitor.cs" />
  </ItemGroup>
  <Target Name="BuildNativeBackdrop" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/build-native-backdrop.ps1&quot;" />
  </Target>
</Project>
